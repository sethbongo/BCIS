# Copy to .env (or run `npm run setup`, which generates one with random secrets).
# Never commit the real .env.

# PostgreSQL connection used by the API server, migrations, seeds and backups.
# Local development cluster (npm run db:start) listens on 5433.
# For the installed PostgreSQL service use port 5432 and your own role/password.
DATABASE_URL=postgres://bcis:CHANGE_ME@127.0.0.1:5433/bcis

# Separate database used only by the automated acceptance tests.
TEST_DATABASE_URL=postgres://bcis:CHANGE_ME@127.0.0.1:5433/bcis_test

# API server. 0.0.0.0 lets the other office PCs reach it over the LAN.
API_HOST=0.0.0.0
API_PORT=4000

# Business timezone used for "today", due dates and aging.
APP_TIMEZONE=Asia/Manila

# Sessions
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30

# Where attachments, backups and logs are stored (relative to the repo root or absolute).
DATA_DIR=./data

# Folder containing pg_dump.exe / pg_restore.exe / psql.exe.
PG_BIN_DIR=C:\Program Files\PostgreSQL\17\bin

LOG_LEVEL=info

# Password given to every demo user created by `npm run db:seed:demo`.
SEED_DEMO_PASSWORD=CHANGE_ME
