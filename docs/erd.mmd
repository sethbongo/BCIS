%% Billing and Ledger
erDiagram
  billing_cycles {
    integer id PK
    char_7_ period
    integer last_generated_by FK
  }
  invoices {
    integer id PK
    varchar_20_ invoice_no
    integer subscriber_id FK
    integer service_account_id FK
    integer billing_cycle_id FK
    date invoice_date
    date due_date
    bigint total
    bigint amount_paid
    bigint balance
    enum_invoice_status status
    integer finalized_by FK
    integer voided_by FK
    integer created_by FK
  }
  invoice_items {
    integer id PK
    integer invoice_id FK
    bigint unit_amount
    bigint amount
  }
  adjustments {
    integer id PK
    varchar_20_ adjustment_no
    integer subscriber_id FK
    integer invoice_id FK
    bigint amount
    integer created_by FK
  }
  ledger_entries {
    bigint id PK
    integer subscriber_id FK
    integer service_account_id FK
    date entry_date
    varchar_30_ reference_no
    bigint debit
    bigint credit
    integer created_by FK
  }
